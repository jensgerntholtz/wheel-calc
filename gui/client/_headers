/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/
  Cache-Control: no-store

/index.html
  Cache-Control: no-store

/app.js
  Cache-Control: public, max-age=600

/styles.css
  Cache-Control: public, max-age=600
